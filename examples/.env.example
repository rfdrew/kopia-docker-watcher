# Copy to .env next to docker-compose.yml and fill in.
# All watcher variables: ../docs/en/configuration.md

# ── kopia server ─────────────────────────────────────────────────────────────
# Repository password. Only kopia server uses it; the watcher does not need it
# and ignores it with a warning if it gets it.
KOPIA_PASSWORD=change-me-repository-password

# The web UI user of kopia server (--server-username, --server-password). The
# watcher logs in as this user: users added with `kopia server user add`
# cannot use the API the watcher needs.
KOPIA_SERVER_USERNAME=kopia
KOPIA_SERVER_PASSWORD=change-me-ui-password

# ── kopia-docker-watcher ─────────────────────────────────────────────────────
# GID of the group that owns the Docker socket on the host:
#   stat -c %g /var/run/docker.sock
# Not needed with docker-socket-proxy.
DOCKER_GID=

# SHA-256 fingerprint of kopia server's certificate: the hex value after
# "SERVER CERT SHA256:" in the kopia server log, printed when it generates the
# certificate on its first start:
#   docker compose logs kopia | grep 'SERVER CERT SHA256'
# For an existing certificate file, the value after "Fingerprint=" (colons are
# accepted):
#   openssl x509 -in tls.crt -noout -fingerprint -sha256
# Not the "SHA256:..." value the Python version's README suggested.
KOPIA_SERVER_CERT_FINGERPRINT=

# Where kopia server sees the host paths of kopia.path. Empty when it mounts
# them at the same paths, as in the example. Set to /host when it mounts the
# host root with - /:/host:ro.
HOST_PREFIX=

# Optional: the watcher never registers, pauses or deletes a source outside
# this path (after HOST_PREFIX).
WATCHER_PATH_PREFIX=

# debug, info, warning or error.
LOG_LEVEL=info

# Optional: where to post a notification when a path starts failing and when it
# works again, and how: json, ntfy, slack or telegram. The URL may hold a
# token; the watcher never logs it. Examples:
#   NOTIFY_WEBHOOK_URL=https://ntfy.sh/my-backups          NOTIFY_WEBHOOK_FORMAT=ntfy
#   NOTIFY_WEBHOOK_URL=https://hooks.slack.com/services/…  NOTIFY_WEBHOOK_FORMAT=slack
#   NOTIFY_WEBHOOK_URL=https://api.telegram.org/bot<token>/sendMessage?chat_id=<chat>
#                                                          NOTIFY_WEBHOOK_FORMAT=telegram
NOTIFY_WEBHOOK_URL=
NOTIFY_WEBHOOK_FORMAT=

# ── example app ──────────────────────────────────────────────────────────────
# Host directory of the example app's data, mounted into kopia server at the
# same path.
DATA_ROOT=/srv/kopia-docker-watcher-example
